# AEGIS Environment Variables - Copy to .env and fill in values

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis_password

# MinIO (for MilvusDB object storage)
MINIO_USER=aegisadmin
MINIO_PASSWORD=change_me_minio_password

# JWT Secret — must be at least 32 characters
SECRET_KEY=change_me_secret_key_at_least_32_chars_long!!

# CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Ollama model selection
OLLAMA_MODEL=codellama:34b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Frontend API URL (used by Vite dev server)
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# LLM Configuration (OpenAI-compatible)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=all-MiniLM-L6-v2
